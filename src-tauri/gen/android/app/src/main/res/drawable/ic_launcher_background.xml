<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon background: a diagonal deep-violet to near-black gradient.

  Replaces two things: a flat #fff background colour, and the stock Android
  Studio green grid that `tauri android init` dropped here and nothing used.

  The mark itself is violet, so a DARK ground is what makes it read against a
  busy wallpaper; a light one washed it out. Keep these stops in sync with
  GRAD_START / GRAD_END in the icon build script, which pre-composites the same
  gradient for pre-26 launchers that cannot render adaptive layers.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#2E1065"
        android:endColor="#0A0A12" />
</shape>
